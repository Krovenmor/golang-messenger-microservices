LISTEN_PORT=8081

DB_CONN_STRING=postgres://auth_user:auth_pass@auth-db:5432/auth_db

JWT_PRVKEY_PATH=/app/certs/jwt/private.key
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=720h

PASS_MIN_LENGTH=5
PASS_MAX_LENGTH=20

LOGIN_MIN_LENGTH=5
LOGIN_MAX_LENGTH=20

REFRESH_TOKEN_LEN=322

HASH_MEMORY=65536
HASH_ITERATIONS=1
HASH_PARALLELISM=2
HASH_SALT_LENGTH=16
HASH_KEY_LENGTH=32

BAN_REPO_LOGIN_PREFIX=ban:login
BAN_REPO_TOKEN_PREFIX=ban:token

VERIFICATION_CODES_TTL=5m
CACHE_TTL_PREFIX=cache:email